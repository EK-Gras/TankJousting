:root {
}

.upgrade_button {
    width: 160px;
    height: 100px;
    flex-grow: 0;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    -unity-font-style: bold;
    font-size: 40px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Sprites/Game-Ready%20Assets/UI/LevelUp_StatPanel_StatValue.png?fileID=2800000&guid=2b64767f8007aaa41a0ab10b621de987&type=3#LevelUp_StatPanel_StatValue");
    top: 30px;
    flex-shrink: 0;
    left: 500px;
    right: auto;
    position: absolute;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.upgrade_label {
    font-size: 40px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    flex-direction: column;
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    width: 550px;
}

.upgrade_label_container {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    width: 300px;
    flex-shrink: 0;
    flex-grow: 0;
    background-color: rgba(255, 255, 255, 0);
}

.upgrade_container {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Sprites/Game-Ready%20Assets/UI/LevelUp_StatPanel.png?fileID=2800000&guid=d36930536ad975147b9b3319de9be94f&type=3#LevelUp_StatPanel");
}

.cursor {
}
